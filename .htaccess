<IfModule mod_rewrite.c>
    RewriteEngine On

    # Detect if running in a subdirectory (XAMPP local) or root (production)
    # RewriteBase is auto-handled by the dynamic BASE_URL in index.php

    # FIRST: Never rewrite actual files (regardless of extension)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # SECOND: Never rewrite actual directories
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route everything else to index.php with GET parameter
    RewriteRule ^(.*)$ index.php?route=$1 [L,QSA]
</IfModule>

# Allow access to assets with caching
<FilesMatch "\.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot|webp)$">
    Header set Cache-Control "max-age=31536000, public"
</FilesMatch>

# Deny access to sensitive files
<FilesMatch "(\.env|composer\.(json|lock))$">
    Deny from all
</FilesMatch>
